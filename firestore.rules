rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.role is string && (
          data.role == 'Owner' || data.role == 'Driver' || 
          data.role == 'Fleet Manager' || data.role == 'Admin' || 
          data.role == 'Dispatcher' || data.role == 'Maintenance Manager'
        );
    }

    // Users Collection
    match /users/{userId} {
      // Authenticated users can read their own profile or view company driver rosters
      allow read: if isSignedIn();

      // Users can create their own profile matching their auth UID
      allow create: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidUser(incoming());

      // Users can update their own profile; preserves user ID
      allow update: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidUser(incoming())
        && incoming().id == existing().id;

      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Fleet Audit Logs Collection
    match /fleet_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
        && incoming().userId == request.auth.uid
        && incoming().action is string && incoming().action.size() <= 100;
      allow update, delete: if false; // Audit logs are immutable
    }

    // Connection testing doc
    match /test/{docId} {
      allow read: if true;
    }
  }
}
